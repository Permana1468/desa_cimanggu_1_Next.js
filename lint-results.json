er justify-between border-b border-slate-700/50 pb-4 last:border-0 last:pb-0\">\n                              <div>\n                                  <p className=\"text-sm font-bold\">Otorisasi 12 Dokumen</p>\n                                  <p className=\"text-[10px] text-slate-400 mt-1\">24 Jul 2026, 09:30 AM</p>\n                              </div>\n                              <span className=\"text-[10px] font-bold bg-slate-700 text-slate-300 px-2 py-1 rounded-md\">\n                                  Berhasil\n                              </span>\n                          </div>\n                      ))}\n                  </div>\n              </div>\n          </motion.div>\n      )}\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/media/aldyansyah/DATA_STORAGE/desa_cimanggu_1_Next.js/src/components/dashboard/kasi-pelayanan/ManajemenKependudukan.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Users' is defined but never used.","line":5,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":5,"endColumn":8,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Users"},"fix":{"range":[67,73],"text":""},"desc":"Remove unused variable \"Users\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'session' is defined but never used.","line":14,"column":41,"nodeType":"Identifier","messageId":"unusedVar","endLine":14,"endColumn":48}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\n\nimport { motion } from \"framer-motion\";\nimport { \n  Users, \n  UserPlus, \n  UserMinus, \n  RefreshCcw, \n  Search, \n  FileText,\n  AlertCircle\n} from \"lucide-react\";\n\nexport function ManajemenKependudukan({ session }: { session: any }) {\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"bg-white rounded-[2rem] p-6 shadow-sm border border-slate-100 flex flex-col md:flex-row items-center justify-between gap-4\">\n        <div>\n            <h1 className=\"text-2xl font-black text-slate-800\">Manajemen Kependudukan</h1>\n            <p className=\"text-slate-500 text-sm mt-1\">Mutasi warga dan pencatatan peristiwa kependudukan.</p>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n          {/* Menu Kiri */}\n          <div className=\"lg:col-span-1 space-y-4\">\n              <button className=\"w-full text-left bg-emerald-600 text-white p-6 rounded-[2rem] shadow-lg shadow-emerald-600/20 relative overflow-hidden group hover:scale-[1.02] transition-transform\">\n                  <div className=\"absolute top-0 right-0 w-24 h-24 bg-white/20 rounded-full blur-xl -mr-10 -mt-10\" />\n                  <UserPlus size={32} className=\"mb-4 text-emerald-200 group-hover:scale-110 transition-transform\" />\n                  <h3 className=\"font-black text-xl mb-1\">Mutasi Masuk</h3>\n                  <p className=\"text-emerald-100 text-sm\">Registrasi warga pindahan baru.</p>\n              </button>\n\n              <button className=\"w-full text-left bg-rose-600 text-white p-6 rounded-[2rem] shadow-lg shadow-rose-600/20 relative overflow-hidden group hover:scale-[1.02] transition-transform\">\n                  <div className=\"absolute top-0 right-0 w-24 h-24 bg-white/20 rounded-full blur-xl -mr-10 -mt-10\" />\n                  <UserMinus size={32} className=\"mb-4 text-rose-200 group-hover:scale-110 transition-transform\" />\n                  <h3 className=\"font-black text-xl mb-1\">Mutasi Keluar</h3>\n                  <p className=\"text-rose-100 text-sm\">Pencatatan warga pindah / meninggal.</p>\n              </button>\n\n              <button className=\"w-full text-left bg-indigo-600 text-white p-6 rounded-[2rem] shadow-lg shadow-indigo-600/20 relative overflow-hidden group hover:scale-[1.02] transition-transform\">\n                  <div className=\"absolute top-0 right-0 w-24 h-24 bg-white/20 rounded-full blur-xl -mr-10 -mt-10\" />\n                  <RefreshCcw size={32} className=\"mb-4 text-indigo-200 group-hover:scale-110 transition-transform\" />\n                  <h3 className=\"font-black text-xl mb-1\">Peristiwa Lainnya</h3>\n                  <p className=\"text-indigo-100 text-sm\">Kelahiran, perubahan KK, dll.</p>\n              </button>\n          </div>\n\n          {/* Form Pencarian Induk Kependudukan */}\n          <div className=\"lg:col-span-2 space-y-6\">\n              <motion.div \n                initial={{ opacity: 0, y: 10 }}\n                animate={{ opacity: 1, y: 0 }}\n                className=\"bg-white rounded-[2rem] p-8 shadow-sm border border-slate-100\"\n              >\n                  <h2 className=\"text-lg font-black text-slate-800 mb-6 flex items-center gap-2\">\n                      <Search className=\"text-indigo-600\" />\n                      Cari Data Induk Kependudukan\n                  </h2>\n                  <div className=\"flex gap-4 mb-8\">\n                      <input \n                          type=\"text\" \n                          placeholder=\"Masukkan NIK atau No. KK...\" \n                          className=\"flex-1 px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all outline-none\"\n                      />\n                      <button className=\"px-6 bg-indigo-600 text-white font-bold rounded-xl hover:bg-indigo-700 transition-colors shadow-lg shadow-indigo-600/20\">\n                          Cari Data\n                      </button>\n                  </div>\n\n                  <div className=\"p-8 border-2 border-dashed border-slate-200 rounded-2xl flex flex-col items-center justify-center text-slate-400 bg-slate-50/50\">\n                      <FileText size={48} className=\"mb-4 text-slate-300\" />\n                      <p className=\"font-bold\">Data warga akan muncul di sini</p>\n                      <p className=\"text-sm mt-1\">Lakukan pencarian terlebih dahulu.</p>\n                  </div>\n              </motion.div>\n\n              <motion.div \n                initial={{ opacity: 0, y: 10 }}\n                animate={{ opacity: 1, y: 0 }}\n                transition={{ delay: 0.1 }}\n                className=\"bg-amber-50 rounded-[2rem] p-6 border border-amber-200 flex gap-4\"\n              >\n                  <AlertCircle size={24} className=\"text-amber-600 shrink-0\" />\n                  <div>\n                      <h3 className=\"font-bold text-amber-800 mb-1\">Integrasi Data Induk</h3>\n                      <p className=\"text-amber-700/80 text-sm\">\n                          Setiap perubahan mutasi (masuk/keluar) yang dilakukan melalui panel ini akan secara otomatis terhubung dan memperbarui master database kependudukan utama desa. Pastikan data sudah valid sebelum disimpan.\n                      </p>\n                  </div>\n              </motion.div>\n          </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/media/aldyansyah/DATA_STORAGE/desa_cimanggu_1_Next.js/src/components/dashboard/kasi-pelayanan/PusatPersuratan.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'CheckCircle2' is defined but never used.","line":10,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":10,"endColumn":15,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"CheckCircle2"},"fix":{"range":[123,139],"text":""},"desc":"Remove unused variable \"CheckCircle2\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Clock' is defined but never used.","line":11,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":11,"endColumn":8,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Clock"},"fix":{"range":[139,148],"text":""},"desc":"Remove unused variable \"Clock\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Upload' is defined but never used.","line":14,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":14,"endColumn":9,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Upload"},"fix":{"range":[170,180],"text":""},"desc":"Remove unused variable \"Upload\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'session' is defined but never used.","line":22,"column":35,"nodeType":"Identifier","messageId":"unusedVar","endLine":22,"endColumn":42},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'loading' is assigned a value but never used.","line":29,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":29,"endColumn":17},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'setLoading' is assigned a value but never used.","line":29,"column":19,"nodeType":"Identifier","messageId":"unusedVar","endLine":29,"endColumn":29},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadTemplates'. Either include it or remove the dependency array.","line":33,"column":6,"nodeType":"ArrayExpression","endLine":33,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [loadTemplates]","fix":{"range":[804,806],"text":"[loadTemplates]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":7,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\n\nimport { motion } from \"framer-motion\";\nimport { \n  FileText, \n  Plus, \n  Folder, \n  FolderArchive,\n  Search,\n  CheckCircle2,\n  Clock,\n  Printer,\n  PenTool,\n  Upload,\n  ArrowRight,\n  Loader2,\n  Filter\n} from \"lucide-react\";\nimport { useState, useEffect } from \"react\";\nimport { getLetterTemplates } from \"@/actions/documents\";\n\nexport function PusatPersuratan({ session, tab }: { session: any, tab: string }) {\n  const [activeSubTab, setActiveSubTab] = useState(tab || 'buat-surat');\n  \n  // Dynamic Forms State\n  const [templates, setTemplates] = useState<any[]>([]);\n  const [selectedTemplate, setSelectedTemplate] = useState<any>(null);\n  const [formData, setFormData] = useState<any>({});\n  const [loading, setLoading] = useState(false);\n\n  useEffect(() => {\n    loadTemplates();\n  }, []);\n\n  async function loadTemplates() {\n      const data = await getLetterTemplates();\n      setTemplates(data);\n      if (data.length > 0) {\n          handleSelectTemplate(data[0].id, data);\n      }\n  }\n\n  function handleSelectTemplate(templateId: string, currentTemplates = templates) {\n      const tpl = currentTemplates.find(t => t.id === templateId);\n      setSelectedTemplate(tpl);\n      \n      // Initialize form data based on schema\n      const initialData: any = {};\n      if (tpl && tpl.formSchema && Array.isArray(tpl.formSchema)) {\n          tpl.formSchema.forEach((field: any) => {\n              initialData[field.name] = \"\";\n          });\n      }\n      setFormData(initialData);\n  }\n\n  function handleFieldChange(name: string, value: string) {\n      setFormData({ ...formData, [name]: value });\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"bg-white rounded-[2rem] p-6 shadow-sm border border-slate-100 flex flex-col md:flex-row items-center justify-between gap-4\">\n        <div>\n            <h1 className=\"text-2xl font-black text-slate-800\">Pusat Persuratan</h1>\n            <p className=\"text-slate-500 text-sm mt-1\">Pembuatan surat, penomoran otomatis, dan buku agenda surat desa.</p>\n        </div>\n        <div className=\"flex bg-slate-100 p-1.5 rounded-2xl w-full md:w-auto\">\n            {[\n              { id: 'buat-surat', label: 'Buat Surat', icon: Plus },\n              { id: 'surat-masuk', label: 'Surat Masuk', icon: Folder },\n              { id: 'surat-keluar', label: 'Surat Keluar', icon: FolderArchive }\n            ].map(t => (\n                <button\n                    key={t.id}\n                    onClick={() => setActiveSubTab(t.id)}\n                    className={`flex-1 md:px-5 py-2.5 rounded-xl text-sm font-bold transition-all flex items-center justify-center gap-2 ${\n                        activeSubTab === t.id ? 'bg-white text-indigo-600 shadow-sm' : 'text-slate-500 hover:text-slate-700'\n                    }`}\n                >\n                    <t.icon size={16} /> <span className=\"hidden md:inline\">{t.label}</span>\n                </button>\n            ))}\n        </div>\n      </div>\n\n      {/* Main Content Area based on SubTab */}\n      {activeSubTab === 'buat-surat' && (\n        <motion.div \n            initial={{ opacity: 0, y: 10 }}\n            animate={{ opacity: 1, y: 0 }}\n            className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\"\n        >\n            {/* Form Buat Surat */}\n            <div className=\"lg:col-span-2 bg-white rounded-[2rem] p-8 shadow-sm border border-slate-100\">\n                <h2 className=\"text-lg font-black text-slate-800 mb-6\">Formulir Pembuatan Surat</h2>\n                \n                {templates.length === 0 ? (\n                    <div className=\"text-center py-10\">\n                        <Loader2 className=\"animate-spin mx-auto mb-4 text-slate-400\" size={32} />\n                        <p className=\"text-slate-500 font-bold\">Memuat Master Form...</p>\n                    </div>\n                ) : (\n                    <form className=\"space-y-6\">\n                        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-5\">\n                            <div className=\"space-y-2\">\n                                <label className=\"text-xs font-bold text-slate-500 uppercase tracking-widest\">Jenis Surat</label>\n                                <select \n                                    value={selectedTemplate?.id || \"\"}\n                                    onChange={(e) => handleSelectTemplate(e.target.value)}\n                                    className=\"w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all text-slate-700 outline-none font-bold\"\n                                >\n                                    {templates.map(tpl => (\n                                        <option key={tpl.id} value={tpl.id}>{tpl.name}</option>\n                                    ))}\n                                </select>\n                            </div>\n                            <div className=\"space-y-2\">\n                                <label className=\"text-xs font-bold text-slate-500 uppercase tracking-widest flex items-center justify-between\">\n                                    Penomoran Surat\n                                    <span className=\"text-[9px] bg-emerald-100 text-emerald-600 px-2 py-0.5 rounded-md\">Otomatis (Integrasi TU)</span>\n                                </label>\n                                <input type=\"text\" value={`145/${selectedTemplate?.code || \"XX\"}/VII/2026`} disabled className=\"w-full px-4 py-3 rounded-xl bg-slate-100 border border-slate-200 text-slate-500 font-mono font-bold\" />\n                            </div>\n                        </div>\n\n                        <div className=\"space-y-2\">\n                            <label className=\"text-xs font-bold text-slate-500 uppercase tracking-widest\">NIK / Nama Pemohon</label>\n                            <div className=\"relative\">\n                                <Search className=\"absolute left-4 top-1/2 -translate-y-1/2 text-slate-400\" size={18} />\n                                <input type=\"text\" placeholder=\"Cari warga berdasarkan NIK atau Nama...\" className=\"w-full pl-11 pr-4 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all outline-none font-bold\" />\n                            </div>\n                        </div>\n\n                        {/* DYNAMIC FORM FIELDS RENDERER */}\n                        {selectedTemplate && selectedTemplate.formSchema && Array.isArray(selectedTemplate.formSchema) && selectedTemplate.formSchema.length > 0 ? (\n                            <div className=\"border-t border-slate-100 pt-6 mt-6 space-y-5\">\n                                <h3 className=\"text-sm font-black text-slate-800 flex items-center gap-2\">\n                                    <FileText size={18} className=\"text-indigo-500\" /> Isian Khusus {selectedTemplate.code}\n                                </h3>\n                                \n                                {selectedTemplate.formSchema.map((field: any, idx: number) => (\n                                    <div key={idx} className=\"space-y-2\">\n                                        <label className=\"text-xs font-bold text-slate-500 uppercase tracking-widest\">{field.label}</label>\n                                        \n                                        {field.type === 'textarea' ? (\n                                            <textarea \n                                                rows={3} \n                                                value={formData[field.name] || \"\"}\n                                                onChange={e => handleFieldChange(field.name, e.target.value)}\n                                                placeholder={`Masukkan ${field.label.toLowerCase()}...`} \n                                                className=\"w-full px-4 py-3 rounded-xl bg-white border border-slate-200 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all outline-none resize-none font-medium shadow-sm\"\n                                            ></textarea>\n                                        ) : field.type === 'date' ? (\n                                            <input \n                                                type=\"date\"\n                                                value={formData[field.name] || \"\"}\n                                                onChange={e => handleFieldChange(field.name, e.target.value)}\n                                                className=\"w-full px-4 py-3 rounded-xl bg-white border border-slate-200 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all outline-none font-medium shadow-sm\"\n                                            />\n                                        ) : (\n                                            <input \n                                                type=\"text\"\n                                                value={formData[field.name] || \"\"}\n                                                onChange={e => handleFieldChange(field.name, e.target.value)}\n                                                placeholder={`Masukkan ${field.label.toLowerCase()}...`} \n                                                className=\"w-full px-4 py-3 rounded-xl bg-white border border-slate-200 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all outline-none font-medium shadow-sm\"\n                                            />\n                                        )}\n                                    </div>\n                                ))}\n                            </div>\n                        ) : (\n                            <div className=\"border-t border-slate-100 pt-6 mt-6\">\n                                <div className=\"space-y-2\">\n                                    <label className=\"text-xs font-bold text-slate-500 uppercase tracking-widest\">Keperluan Dasar</label>\n                                    <textarea rows={3} placeholder=\"Tuliskan keperluan...\" className=\"w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all outline-none resize-none\"></textarea>\n                                </div>\n                            </div>\n                        )}\n\n                        <div className=\"pt-4 flex gap-4\">\n                            <button type=\"button\" className=\"flex-1 bg-slate-100 text-slate-600 font-bold py-3.5 rounded-xl hover:bg-slate-200 transition-colors\">\n                                Simpan Draft\n                            </button>\n                            <button type=\"button\" className=\"flex-1 bg-indigo-600 text-white font-black py-3.5 rounded-xl hover:bg-indigo-700 shadow-lg shadow-indigo-600/20 transition-colors flex items-center justify-center gap-2\">\n                                <Printer size={18} /> Cetak & Terbitkan\n                            </button>\n                        </div>\n                    </form>\n                )}\n            </div>\n\n            {/* Panel Kanan */}\n            <div className=\"space-y-6\">\n                <div className=\"bg-gradient-to-br from-indigo-500 to-blue-600 rounded-[2rem] p-6 text-white shadow-lg shadow-indigo-500/20 relative overflow-hidden\">\n                    <div className=\"absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-full blur-xl -mr-10 -mt-10\" />\n                    <PenTool size={24} className=\"mb-4 text-indigo-100\" />\n                    <h3 className=\"font-black text-lg mb-1\">Tanda Tangan Elektronik</h3>\n                    <p className=\"text-sm text-indigo-100/80 mb-6\">Gunakan TTE Kades terenkripsi untuk pengesahan surat instan.</p>\n                    <button className=\"w-full py-2.5 bg-white/20 hover:bg-white/30 transition-colors rounded-xl font-bold text-sm backdrop-blur-md\">\n                        Otorisasi TTE\n                    </button>\n                </div>\n\n                <div className=\"bg-white rounded-[2rem] p-6 border border-slate-100 shadow-sm\">\n                    <h3 className=\"font-black text-slate-800 mb-4\">Pemohon Online (Menunggu)</h3>\n                    <div className=\"space-y-3\">\n                        {[1, 2].map((i) => (\n                            <div key={i} className=\"p-3 rounded-xl border border-slate-100 bg-slate-50 flex items-center justify-between group hover:border-indigo-200 transition-colors cursor-pointer\">\n                                <div>\n                                    <p className=\"font-bold text-sm text-slate-800\">Agus Setiawan</p>\n                                    <p className=\"text-[10px] text-slate-500 uppercase tracking-wider font-bold mt-0.5\">Surat Ket. Domisili</p>\n                                </div>\n                                <button className=\"w-8 h-8 rounded-lg bg-indigo-100 text-indigo-600 flex items-center justify-center group-hover:bg-indigo-600 group-hover:text-white transition-colors\">\n                                    <ArrowRight size={14} />\n                                </button>\n                            </div>\n                        ))}\n                    </div>\n                </div>\n            </div>\n        </motion.div>\n      )}\n\n      {(activeSubTab === 'surat-masuk' || activeSubTab === 'surat-keluar') && (\n          <motion.div \n            initial={{ opacity: 0, y: 10 }}\n            animate={{ opacity: 1, y: 0 }}\n            className=\"bg-white rounded-[2rem] shadow-sm border border-slate-100 overflow-hidden\"\n          >\n              <div className=\"p-6 border-b border-slate-100 flex flex-col md:flex-row items-center justify-between gap-4\">\n                  <div>\n                      <h2 className=\"text-lg font-black text-slate-800\">\n                          Buku Agenda {activeSubTab === 'surat-masuk' ? 'Surat Masuk' : 'Surat Keluar'}\n                      </h2>\n                      <p className=\"text-xs text-slate-500 mt-1\">Terintegrasi dengan Kaur TU.</p>\n                  </div>\n                  <div className=\"flex items-center gap-3 w-full md:w-auto\">\n                      <div className=\"relative flex-1 md:w-64\">\n                          <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" size={16} />\n                          <input type=\"text\" placeholder=\"Cari surat...\" className=\"w-full pl-10 pr-4 py-2 rounded-xl bg-slate-50 border-none focus:ring-2 focus:ring-indigo-500/20 text-sm outline-none font-bold\" />\n                      </div>\n                      <button className=\"p-2 bg-slate-50 text-slate-500 rounded-xl hover:bg-slate-100 transition-colors\">\n                          <Filter size={20} />\n                      </button>\n                  </div>\n              </div>\n              <div className=\"overflow-x-auto\">\n                  <table className=\"w-full text-left\">\n                      <thead>\n                          <tr className=\"text-slate-400 text-[10px] font-black uppercase tracking-widest border-b border-slate-50 bg-slate-50/50\">\n                              <th className=\"py-4 pl-6\">Tanggal</th>\n                              <th>Nomor Surat</th>\n                              <th>Tujuan/Pengirim</th>\n                              <th>Perihal</th>\n                              <th>Status</th>\n                          </tr>\n                      </thead>\n                      <tbody className=\"divide-y divide-slate-50\">\n                          <tr>\n                              <td colSpan={5} className=\"py-20 text-center\">\n                                  <div className=\"w-16 h-16 bg-slate-50 text-slate-300 rounded-full flex items-center justify-center mx-auto mb-4\">\n                                      <FolderArchive size={32} />\n                                  </div>\n                                  <p className=\"text-slate-500 font-medium text-sm\">Belum ada arsip surat.</p>\n                           