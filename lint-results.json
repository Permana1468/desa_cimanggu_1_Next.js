             <h3 className=\"font-bold text-slate-800 mb-4\">Berita Terakhir (Live)</h3>\n                    <div className=\"space-y-4\">\n                        {initialNews?.slice(0, 3).map((news: any, idx: number) => (\n                            <div key={idx} className=\"p-3 bg-slate-50 rounded-xl border border-slate-100 hover:border-indigo-200 transition-colors cursor-pointer group\">\n                                <h4 className=\"font-bold text-sm text-slate-700 group-hover:text-indigo-600 mb-1 line-clamp-1\">{news.judul}</h4>\n                                <span className=\"text-xs text-slate-500\">{new Date(news.createdAt).toLocaleDateString('id-ID')}</span>\n                            </div>\n                        ))}\n                        {(!initialNews || initialNews.length === 0) && (\n                            <p className=\"text-sm text-slate-400 text-center py-4\">Belum ada berita.</p>\n                        )}\n                    </div>\n                </div>\n            </div>\n        </div>\n      )}\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/media/aldyansyah/DATA_STORAGE/desa_cimanggu_1_Next.js/src/components/dashboard/roles/operator/CyberPlanHargaSatuanWrapper.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/media/aldyansyah/DATA_STORAGE/desa_cimanggu_1_Next.js/src/components/dashboard/roles/operator/PersuratanLayanan.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/media/aldyansyah/DATA_STORAGE/desa_cimanggu_1_Next.js/src/components/dashboard/roles/operator/SistemLog.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'ShieldAlert' is defined but never used.","line":3,"column":35,"nodeType":"Identifier","mess