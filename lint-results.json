e it or remove the dependency array.","line":119,"column":6,"nodeType":"ArrayExpression","endLine":119,"endColumn":17,"suggestions":[{"desc":"Update the dependencies array to be: [activeTab, fetchStats]","fix":{"range":[5202,5213],"text":"[activeTab, fetchStats]"}}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'TabButton' is defined but never used.","line":201,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":201,"endColumn":19},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadWarga'. Either include it or remove the dependency array.","line":416,"column":6,"nodeType":"ArrayExpression","endLine":416,"endColumn":26,"suggestions":[{"desc":"Update the dependencies array to be: [filterRt, filterRw, loadWarga]","fix":{"range":[19951,19971],"text":"[filterRt, filterRw, loadWarga]"}}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'e' is defined but never used.","line":494,"column":14,"nodeType":"Identifier","messageId":"unusedVar","endLine":494,"endColumn":15},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'showPrint' is assigned a value but never used.","line":1081,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":1081,"endColumn":19},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'setShowPrint' is assigned a value but never used.","line":1081,"column":21,"nodeType":"Identifier","messageId":"unusedVar","endLine":1081,"endColumn":33},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadData'. Either include it or remove the dependency array.","line":1334,"column":36,"nodeType":"ArrayExpression","endLine":1334,"endColumn":38,"suggestions":[{"desc":"Update the dependencies array to be: [loadData]","fix":{"range":[67971,67973],"text":"[loadData]"}}]},{"ruleId":"@next/next/no-img-element","severity":1,"message":"Usi