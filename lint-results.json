rder-white/20 text-[10px] font-bold uppercase tracking-widest\">\n                    <Wallet size={14} /> Keuangan Desa\n                </div>\n                <h1 className=\"text-4xl md:text-5xl font-black tracking-tight\">\n                    {roleName}\n                </h1>\n                <p className=\"text-amber-100 max-w-xl leading-relaxed\">\n                    Halo, <span className=\"text-white font-bold\">{session?.user?.name}</span>. Pantau APBDes, serapan anggaran, dan progres RAB hari ini.\n                </p>\n            </div>\n\n            <div className=\"grid grid-cols-2 gap-4\">\n                <div className=\"bg-white/10 border border-white/20 rounded-2xl p-4 min-w-[140px] backdrop-blur-md\">\n                    <span className=\"block text-[10px] font-bold text-amber-100 mb-1 uppercase\">Serapan Dana Desa</span>\n                    <span className=\"block text-3xl font-black text-white\">45%</span>\n                </div>\n                <div className=\"bg-white/10 border border-white/20 rounded-2xl p-4 min-w-[140px] backdrop-blur-md\">\n                    <span className=\"block text-[10px] font-bold text-amber-100 mb-1 uppercase\">Sisa Anggaran</span>\n                    <span className=\"block text-xl font-black text-white mt-1\">Rp 450 Juta</span>\n                </div>\n            </div>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n        <div className=\"lg:col-span-2 space-y-6\">\n            <div className=\"bg-white rounded-[2.5rem] p-8 shadow-sm border border-slate-200/60\">\n                <div className=\"flex items-center justify-between mb-8\">\n                    <div>\n                        <h2 className=\"text-xl font-black text-slate-800\">Ringkasan APBDes 2026</h2>\n                        <p className=\"text-slate-500 text-sm\">Alokasi dan realisasi anggaran berjalan.</p>\n                    </div>\n                </div>\n                \n                <div className=\"space-y-4\">\n                    <div className=\"p-5 border border-slate-100 rounded-2xl flex items-center justify-between hover:border-amber-200 transition-colors\">\n                        <div className=\"flex items-center gap-4\">\n                            <div className=\"w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center\">\n                                <ArrowDownRight size={24} />\n                            </div>\n                            <div>\n                                <h4 className=\"font-bold text-slate-800\">Pendapatan Desa</h4>\n                                <span className=\"text-xs text-slate-400\">Target: Rp 1.2 Miliar</span>\n                            </div>\n                        </div>\n                        <div className=\"text-right\">\n                            <span className=\"block font-black text-emerald-600\">Rp 800 Juta</span>\n                            <span className=\"text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded\">66% Tercapai</span>\n                        </div>\n                    </div>\n\n                    <div className=\"p-5 border border-slate-100 rounded-2xl flex items-center justify-between hover:border-amber-200 transition-colors\">\n                        <div className=\"flex items-center gap-4\">\n                            <div className=\"w-12 h-12 bg-rose-50 text-rose-600 rounded-xl flex items-center justify-center\">\n                                <ArrowUpRight size={24} />\n                            </div>\n                            <div>\n                                <h4 className=\"font-bold text-slate-800\">Belanja Desa</h4>\n                                <span className=\"text-xs text-slate-400\">Pagu: Rp 1.2 Miliar</span>\n                            </div>\n                        </div>\n                        <div className=\"text-right\">\n                            <span className=\"block font-black text-rose-600\">Rp 450 Juta</span>\n                            <span className=\"text-[10px] font-bold text-rose-600 bg-rose-50 px-2 py-0.5 rounded\">37% Terserap</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <div className=\"space-y-6\">\n            <div className=\"bg-white rounded-[2rem] p-6 shadow-sm border border-slate-100\">\n                <h2 className=\"text-lg font-black text-slate-800 mb-4\">Menu Keuangan</h2>\n                <div className=\"grid grid-cols-2 gap-3\">\n                    <button className=\"flex flex-col items-center gap-2 p-4 rounded-2xl bg-amber-50 text-amber-600 hover:bg-amber-100 transition-colors\">\n                        <FileSpreadsheet size={24} />\n                        <span className=\"text-[10px] font-bold text-center\">Input RAB</span>\n                    </button>\n                    <button className=\"flex flex-col items-center gap-2 p-4 rounded-2xl bg-slate-50 text-slate-600 hover:bg-slate-100 transition-colors\">\n                        <PieChart size={24} />\n                        <span className=\"text-[10px] font-bold text-center\">Laporan Realisasi</span>\n                    </button>\n                </div>\n            </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/media/aldyansyah/DATA_STORAGE/desa_cimanggu_1_Next.js/src/components/dashboard/roles/LpmDashboardClient.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'MapPin' is defined but never used.","line":20,"column":5,"nodeType":"Identifier","messageId":"unusedVar","endLine":20,"endColumn":11,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"MapPin"},"fix":{"range":[490,503],"text":""},"desc":"Remove unused variable \"MapPin\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'CheckCircle2' is defined but never used.","line":22,"column":5,"nodeType":"Identifier","messageId":"unusedVar","endLine":22,"endColumn":17,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"CheckCircle2"},"fix":{"range":[515,534],"text":""},"desc":"Remove unused variable \"CheckCircle2\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'HardHat' is defined but never used.","line":30,"column":5,"nodeType":"Identifier","messageId":"unusedVar","endLine":30,"endColumn":12,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"HardHat"},"fix":{"range":[622,635],"text":""},"desc":"Remove unused variable \"HardHat\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'router' is assigned a value but never used.","line":38,"column":11,"nodeType":"Identifier","messageId":"unusedVar","endLine":38,"endColumn":17},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'error' is defined but never used.","line":129,"column":18,"nodeType":"Identifier","messageId":"unusedVar","endLine":129,"endColumn":23},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'error' is defined but never used.","line":142,"column":18,"nodeType":"Identifier","messageId":"unusedVar","endLine":142,"endColumn":23},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'error' is defined but never used.","line":170,"column":18,"nodeType":"Identifier","messageId":"unusedVar","endLine":170,"endColumn":23},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'error' is defined but never used.","line":183,"column":18,"nodeType":"Identifier","messageId":"unusedVar","endLine":183,"endColumn":23},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'completedProgramsCount' is assigned a value but never used.","line":217,"column":11,"nodeType":"Identifier","messageId":"unusedVar","endLine":217,"endColumn":33},{"ruleId":"@next/next/no-img-element","severity":1,"message":"Using `<