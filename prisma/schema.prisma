// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ==============================
// 1. TENANT (Multi-Tenant System)
// ==============================
model Tenant {
  id          String   @id @default(uuid())
  name        String
  domain      String?  @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  auditLogs   AuditLog[]
  dataKependudukan DataKependudukan[]
  surat       Surat[]
  berita      Berita[]
  profile     VillageProfile?
  bumdesStats BumdesFinancial[]
  bumdesUnits BumdesUnit[]
  lembagas    Lembaga[]
  aparatur    AparaturDesa[]
  letterTemplates LetterTemplate[]
  financeProposals FinanceProposal[]
  mapBoundaries   MapBoundary[]
  
  // New modules
  infrastrukturProjects InfrastrukturProject[]
  apbdesFinances       ApbdesFinance[]
  villageDocuments     VillageDocument[]

  // RT Modules
  rtFinances           RtFinance[]
  rtActivities         RtActivity[]
  rtBirthReports       RtBirthReport[]
  rtDeathReports       RtDeathReport[]
  rtMoveReports        RtMoveReport[]
  rtIncomingReports    RtIncomingReport[]
  rtAnnouncements      RtAnnouncement[]
  rtComplaints         RtComplaint[]
  rtInventories        RtInventory[]
  rtInventoryLoans     RtInventoryLoan[]
  sensusPoints         SensusPoint[]
  bansosData           BansosData[]
}

// ==============================
// 2. USER & ROLE MANAGEMENT
// ==============================
enum RoleType {
  ADMIN_MASTER
  ADMIN_DESA
  RT
  RW
  SEKDES
  KADES
  WARGA
  PKK
  POSYANDU
  LPM
  BPD
  KASI
  KAUR
  KADUS
  KARANG_TARUNA
  PERANGKAT_DESA
  TP_PKK
  PUSKESOS
  PETUGAS_SENSUS
  BUMDES
  PEMILIK_TOKO_UMKM
  OPERATOR_DESA
}

model User {
  id                    String    @id @default(uuid())
  email                 String?   @unique
  nik                   String?   @unique
  passwordHash          String
  fullName              String
  role                  RoleType  @default(WARGA)
  rt                    String?   // Wilayah RT (e.g., "001")
  rw                    String?   // Wilayah RW (e.g., "005")
  isActive              Boolean   @default(true)
  
  // New Fields for Registration & Verification
  phoneNumber           String?   // WhatsApp
  whatsappVerified      Boolean   @default(false)
  isFirstLogin          Boolean   @default(true)
  position              String?   // e.g., "Kepala Desa", "Bendahara"


  // 2FA Fields
  twoFactorSecret       String?
  isTwoFactorEnabled    Boolean   @default(false)

  // Multi-Tenant
  tenantId              String
  tenant                Tenant    @relation(fields: [tenantId], references: [id])

  // Relation to Official Citizen Data
  residentId            String?   @unique
  resident              DataKependudukan? @relation(fields: [residentId], references: [id])

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  auditLogs             AuditLog[]
  suratDibuat           Surat[]   @relation("Pencatat")
  financeProposals      FinanceProposal[]
  trackings             Tracking[]
  
  // New modules
  infrastrukturProjects InfrastrukturProject[]
  apbdesFinances       ApbdesFinance[]
  villageDocuments     VillageDocument[]

  @@index([tenantId, role])
  @@index([tenantId, isActive])
}

// ==============================
// 3. AUDIT LOG (Sistem Log)
// ==============================
model AuditLog {
  id          String   @id @default(uuid())
  action      String   // e.g., "CREATE_USER", "DELETE_DATA"
  entity      String   // e.g., "User", "DataKependudukan"
  entityId    String?
  details     Json?    // Optional JSON payload describing the change
  ipAddress   String?
  userAgent   String?

  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  category    String   @default("SYSTEM") // SYSTEM, SECURITY, USER_ACTION
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, category])
}

// ==============================
// 3.1 ROLE PERMISSIONS (RBAC)
// ==============================
model RolePermission {
  id          String   @id @default(uuid())
  role        RoleType
  module      String   // e.g., "SURAT", "WARGA", "KEUANGAN"
  canView     Boolean  @default(false)
  canCreate   Boolean  @default(false)
  canUpdate   Boolean  @default(false)
  canDelete   Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([role, module])
}

// ==============================
// 4. DATA KEPENDUDUKAN
// ==============================
model DataKependudukan {
  id                String   @id @default(uuid())
  nik               String   @unique
  noKK              String
  namaLengkap       String
  tempatLahir       String
  tanggalLahir      DateTime
  jenisKelamin      String   // LAKI_LAKI, PEREMPUAN
  agama             String
  pendidikan        String?
  pekerjaan         String?
  golonganDarah     String?
  statusKawin       String   // BELUM_KAWIN, KAWIN, CERAI_HIDUP, CERAI_MATI
  hubunganKeluarga  String   // KEPALA_KELUARGA, ISTRI, ANAK, dll
  kewarganegaraan   String   @default("WNI")
  namaAyah          String?
  namaIbu           String?
  
  alamat            String
  rt                String
  rw                String
  dusun             String
  
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])

  // Link to User account (if they register)
  user              User?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  surat             Surat[]
  bansosData        BansosData?

  @@index([tenantId, noKK])
  @@index([tenantId, rt, rw])
  @@index([tenantId, jenisKelamin])
}

// ==============================
// 4.1 BANSOS KESEJAHTERAAN
// ==============================
model BansosData {
  id              String   @id @default(uuid())
  wargaId         String   @unique
  warga           DataKependudukan @relation(fields: [wargaId], references: [id], onDelete: Cascade)
  
  desil           Int?     // 1-10
  jenisBantuan    Json?    // Array of strings, e.g. ["PKH", "BPNT", "BLT-DD"]
  status          String   @default("AKTIF") // AKTIF, NON-AKTIF, USULAN_RT
  keterangan      String?
  
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, desil])
  @@index([tenantId, status])
}


// ==============================
// 5. PERSURATAN (Document Management)
// ==============================
enum StatusSurat {
  TERTUNDA
  TERVERIFIKASI
  DISETUJUI
  DITOLAK
}

model Surat {
  id              String      @id @default(uuid())
  nomorSurat      String?     @unique
  jenisSurat      String      // e.g., "SKU", "SKTM", "Domisili"
  status          StatusSurat @default(TERTUNDA)
  keperluan       String?
  
  wargaId         String
  warga           DataKependudukan @relation(fields: [wargaId], references: [id])
  
  adminId         String      // Admin yang menginput
  admin           User        @relation("Pencatat", fields: [adminId], references: [id])
  
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id])

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, jenisSurat])
  @@index([wargaId])
  @@index([adminId])
}

// ==============================
// 5.1 TEMPLATE PERSURATAN
// ==============================
model LetterTemplate {
  id              String   @id @default(uuid())
  name            String   // e.g., "Surat Keterangan Usaha"
  code            String   @unique // e.g., "SKU"
  fileUrl         String   // URL to the .docx template
  version         Int      @default(1)
  isActive        Boolean  @default(true)
  variables       Json?    // e.g., ["nama_usaha", "jenis_usaha"]
  
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==============================
// 6. BERITA & ARTIKEL (CMS)
// ==============================
model Berita {
  id          String   @id @default(uuid())
  judul       String
  slug        String   @unique
  konten      String   @db.Text
  gambar      String?  // URL gambar
  kategori    String   @default("Umum")
  views       Int      @default(0)
  isPublished Boolean  @default(false)
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, isPublished, createdAt])
}

model VillageProfile {
  id          String   @id @default(uuid())
  tenantId    String   @unique
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  // Branding
  logo        String?
  title       String?
  address     String?
  
  // Hero Section
  hero_title    String?
  hero_subtitle String?
  
  // About Section
  about_title   String?
  about_text    String? @db.Text
  about_image   String?

  visi        String?  @db.Text
  misi        Json?    // Array of strings
  sejarah     String?  @db.Text
  luasWilayah String?
  batasUtara  String?
  batasSelatan String?
  batasTimur  String?
  batasBarat  String?
  gallery     Json?    // Array of URLs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BumdesFinancial {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  title       String
  amount      Float
  type        String   // INCOME, EXPENSE
  date        DateTime @default(now())
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BumdesUnit {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  name        String
  description String?
  status      String   @default("Active") // Active, Inactive, Profit, Loss
  growth      String   @default("0%")     // e.g. "+15%" or "-2%"
  color       String   @default("blue")   // for UI highlights
  icon        String   @default("ShoppingBag") // name of lucide icon
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model Lembaga {
  id          String   @id @default(uuid())
  name        String   // e.g., "LPM", "PKK"
  fullName    String
  description String?  @db.Text
  memberCount Int      @default(0)
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  members     LembagaMember[]
  programs    LembagaProgram[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LembagaMember {
  id          String   @id @default(uuid())
  lembagaId   String
  lembaga     Lembaga  @relation(fields: [lembagaId], references: [id], onDelete: Cascade)
  
  name        String
  nik         String?
  position    String   // Custom title e.g. "Ketua LPM"
  photo       String?
  email       String?
  phoneNumber String?
  
  level       Int      @default(2) // 0: Ketua, 1: Sekretaris/Bendahara, 2: Anggota
  order       Int      @default(0)
  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([lembagaId, isActive, level])
}

model LembagaProgram {
  id          String   @id @default(uuid())
  lembagaId   String
  lembaga     Lembaga  @relation(fields: [lembagaId], references: [id], onDelete: Cascade)
  
  title       String
  description String   @db.Text
  date        DateTime @default(now())
  status      String   @default("RENCANA") // RENCANA, BERJALAN, SELESAI
  budget      Float?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([lembagaId])
}

model AparaturDesa {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  name        String
  nik         String?
  role        RoleType
  position    String   // Custom title e.g. "Kepala Desa Cimanggu"
  photo       String?
  email       String?
  phoneNumber String?
  
  // SK Details
  skNumber    String?
  skUrl       String?  // PDF or Doc link
  
  level       Int      @default(0) // 0: Top (Kades), 1: Sekdes, 2: Kasi/Kaur, 3: Kadus
  order       Int      @default(0) // Order in the same level
  parentId    String?
  parent      AparaturDesa? @relation("Hierarchy", fields: [parentId], references: [id])
  children    AparaturDesa[] @relation("Hierarchy")

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, isActive, level])
}

model SystemSetting {
  id          String   @id @default("global_config")
  settings    Json     // Store all JSONB data for PPOB, Payment Gateway, etc.
  
  updatedAt   DateTime @updatedAt
}
model FinanceProposal {
  id          String   @id @default(uuid())
  title       String
  description String
  amount      Float
  status      String   @default("PENDING") // PENDING, VERIFIED, APPROVED, REJECTED
  category    String   // PEMBANGUNAN, SOSIAL, OPERASIONAL, DLL
  submittedBy String
  user        User     @relation(fields: [submittedBy], references: [id])
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  trackings   Tracking[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tracking {
  id                String   @id @default(uuid())
  entityType        String   // SURAT, FINANCE_PROPOSAL
  entityId          String
  status            String
  notes             String?
  updatedBy         String
  user              User     @relation(fields: [updatedBy], references: [id])
  financeProposal   FinanceProposal? @relation(fields: [entityId], references: [id], map: "Tracking_FinanceProposal_fkey")
  createdAt         DateTime @default(now())
}

enum BoundaryType {
  DESA
  DUSUN
  RW
  RT
}

model MapBoundary {
  id          String       @id @default(uuid())
  tenantId    String
  name        String       // Nama wilayah (contoh: "Dusun III", "RW 05", "RT 02")
  type        BoundaryType
  parentName  String?      // Relasi hierarki (contoh: RT 02 memiliki parent "RW 05")
  coordinates Json         // Koordinat GeoJSON Poligon
  color       String       @default("#3b82f6") // Kode warna poligon (hex)
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, name, parentName])
  @@index([tenantId, type])
}


// ==============================
// 10. INFRASTRUKTUR & PEMBANGUNAN
// ==============================
model InfrastrukturProject {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  
  namaProyek      String
  jenisPekerjaan  String   // e.g., Drainase, Jalan, Jembatan, Gedung
  lokasi          String?
  dimensiPanjang  Float?   // in meters
  dimensiLebar    Float?   // in meters
  dimensiTinggi   Float?   // in meters (or thickness/diameter)
  volumeTotal     Float?
  satuanVolume    String?  // m, m2, m3
  
  anggaran        Float
  sumberDana      String?  // e.g., Dana Desa, Banprov
  status          String   @default("PERENCANAAN") // PERENCANAAN, BERJALAN, SELESAI
  laporanLPJUrl   String?
  
  userId          String   // Admin yang input
  user            User     @relation(fields: [userId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, status])
}

// ==============================
// 11. AKUNTABILITAS KEUANGAN (APBDES)
// ==============================
model ApbdesFinance {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  
  tahunAnggaran   Int
  kategori        String   // PENDAPATAN, BELANJA, PEMBIAYAAN
  sumberDana      String?  // e.g., PAD, Dana Desa, ADD
  anggaranTotal   Float
  realisasi       Float    @default(0)
  persentase      Float    @default(0)
  keterangan      String?
  
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, tahunAnggaran, kategori])
}

// ==============================
// 12. PUSAT REGULASI & ARSIP DIGITAL
// ==============================
model VillageDocument {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  
  judul           String
  jenisDokumen    String   // PERDES, PERKADES, SK, UMUM
  nomorDokumen    String?
  tanggalDitetapkan DateTime?
  fileUrl         String   // URL to PDF
  
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, jenisDokumen])
}

// ==============================
// 13. RT MODULES (RT-specific features)
// ==============================
model RtFinance {
  id          String   @id @default(uuid())
  rt          String
  rw          String
  amount      Float
  type        String   // INCOME, EXPENSE
  category    String   // e.g. "Iuran Warga", "Sosial", "Operasional", "Lain-lain"
  date        DateTime @default(now())
  description String?
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, rt, rw])
}

model RtActivity {
  id          String   @id @default(uuid())
  rt          String
  rw          String
  title       String
  description String   @db.Text
  date        DateTime @default(now())
  budget      Float?
  status      String   @default("RENCANA") // RENCANA, TERLAKSANA
  imageUrl    String?

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, rt, rw])
}

model RtBirthReport {
  id           String   @id @default(uuid())
  rt           String
  rw           String
  namaBayi     String
  tanggalLahir DateTime
  jenisKelamin String
  namaAyah     String?
  namaIbu      String?
  keterangan   String?

  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, rt, rw])
}

model RtDeathReport {
  id               String   @id @default(uuid())
  rt               String
  rw               String
  nik              String
  namaLengkap      String
  tanggalMeninggal DateTime
  penyebab         String?
  keterangan       String?

  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId, rt, rw])
}

model RtMoveReport {
  id            String   @id @default(uuid())
  rt            String
  rw            String
  nik           String
  namaLengkap   String
  tanggalPindah DateTime
  alamatTujuan  String
  alasan        String?

  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, rt, rw])
}

model RtIncomingReport {
  id            String   @id @default(uuid())
  rt            String
  rw            String
  nik           String
  noKK          String
  namaLengkap   String
  tanggalDatang DateTime
  alamatAsal    String
  keterangan    String?

  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, rt, rw])
}

model RtAnnouncement {
  id          String   @id @default(uuid())
  rt          String
  rw          String
  title       String
  content     String   @db.Text
  date        DateTime @default(now())
  category    String   // e.g. "Kerja Bakti", "Rapat", "Posyandu", "Berita Duka"
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, rt, rw])
}

model RtComplaint {
  id          String   @id @default(uuid())
  rt          String
  rw          String
  reporterName String
  reporterPhone String?
  title       String
  content     String   @db.Text
  status      String   @default("PENDING") // PENDING, PROSES, SELESAI
  category    String   // e.g. "Fasilitas Umum", "Keamanan", "Sosial", "Lain-lain"
  date        DateTime @default(now())
  notes       String?  @db.Text // Tindak lanjut
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, rt, rw])
}

model RtInventory {
  id          String   @id @default(uuid())
  rt          String
  rw          String
  itemName    String
  quantity    Int
  condition   String   @default("BAIK") // BAIK, RUSAK
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loans       RtInventoryLoan[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, rt, rw])
}

model RtInventoryLoan {
  id            String   @id @default(uuid())
  inventoryId   String
  inventory     RtInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  borrowerName  String
  borrowerPhone String?
  quantity      Int
  loanDate      DateTime @default(now())
  returnDate    DateTime?
  status        String   @default("DIPINJAM") // DIPINJAM, KEMBALI
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, inventoryId])
}

model SensusPoint {
  id            String   @id @default(uuid())
  rt            String
  rw            String
  type          String   // RUMAH_WARGA, FASUM_FASOS
  latitude      Float
  longitude     Float
  nomorUrut     Int?     // Urutan rumah warga
  
  // For RUMAH_WARGA
  noKK          String?  // Linked to DataKependudukan's noKK
  statusWarga   String?  // WARGA_TETAP, KONTRAK, RUMAH_KOSONG
  name          String?  // Family Head name
  
  // For FASUM_FASOS
  categoryFasum String?  // IBADAH, POS_RONDA, LAPANGAN, PEMAKAMAN, UMKM, RAWAN_BENCANA, SAMPAH
  description   String?  @db.Text

  tenantId      String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, rt, rw])
}
