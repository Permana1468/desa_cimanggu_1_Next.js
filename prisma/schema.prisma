// UMKM / Marketplace Models
model UmkmStore {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])

  storeName   String
  description String?
  logo        String?
  banner      String?
  status      String  @default("PENDING") // PENDING, APPROVED, REJECTED, BANNED

  products UmkmProduct[]
  orders   UmkmOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UmkmCategory {
  id       String        @id @default(uuid())
  name     String
  icon     String?
  products UmkmProduct[]
}

model UmkmProduct {
  id         String        @id @default(uuid())
  storeId    String
  store      UmkmStore     @relation(fields: [storeId], references: [id])
  categoryId String?
  category   UmkmCategory? @relation(fields: [categoryId], references: [id])

  name        String
  description String
  price       Float
  stock       Int
  images      String // JSON stringified array of image URLs
  status      String @default("LIVE") // LIVE, REVIEW, HIDDEN
  sold        Int    @default(0)

  orderItems UmkmOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UmkmOrder {
  id      String    @id @default(uuid())
  storeId String
  store   UmkmStore @relation(fields: [storeId], references: [id])
  buyerId String
  buyer   User      @relation(fields: [buyerId], references: [id])

  totalAmount Float
  status      String  @default("UNPAID") // UNPAID, PAID, SHIPPED, COMPLETED, CANCELLED
  address     String?

  items UmkmOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UmkmOrderItem {
  id        String      @id @default(uuid())
  orderId   String
  order     UmkmOrder   @relation(fields: [orderId], references: [id])
  productId String
  product   UmkmProduct @relation(fields: [productId], references: [id])

  quantity Int
  price    Float // Price at the time of purchase
}
