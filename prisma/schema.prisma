// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ==============================
// 1. TENANT (Multi-Tenant System)
// ==============================
model Tenant {
  id          String   @id @default(uuid())
  name        String
  domain      String?  @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  auditLogs   AuditLog[]
  dataKependudukan DataKependudukan[]
  surat       Surat[]
  berita      Berita[]
  profile     VillageProfile?
  bumdesStats BumdesFinancial[]
  lembagas    Lembaga[]
}

// ==============================
// 2. USER & ROLE MANAGEMENT
// ==============================
enum RoleType {
  ADMIN_MASTER
  ADMIN_DESA
  RT
  RW
  SEKDES
  KADES
  WARGA
  PKK
  POSYANDU
  LPM
  BPD
}

model User {
  id                    String    @id @default(uuid())
  email                 String?   @unique
  nik                   String?   @unique
  passwordHash          String
  fullName              String
  role                  RoleType  @default(WARGA)
  isActive              Boolean   @default(true)
  
  // New Fields for Registration & Verification
  phoneNumber           String?   // WhatsApp
  whatsappVerified      Boolean   @default(false)
  isFirstLogin          Boolean   @default(true)
  position              String?   // e.g., "Kepala Desa", "Bendahara"


  // 2FA Fields
  twoFactorSecret       String?
  isTwoFactorEnabled    Boolean   @default(false)

  // Multi-Tenant
  tenantId              String
  tenant                Tenant    @relation(fields: [tenantId], references: [id])

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  auditLogs             AuditLog[]
  suratDibuat           Surat[]   @relation("Pencatat")
}

// ==============================
// 3. AUDIT LOG (Sistem Log)
// ==============================
model AuditLog {
  id          String   @id @default(uuid())
  action      String   // e.g., "CREATE_USER", "DELETE_DATA"
  entity      String   // e.g., "User", "DataKependudukan"
  entityId    String?
  details     Json?    // Optional JSON payload describing the change
  ipAddress   String?
  userAgent   String?

  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

// ==============================
// 4. DATA KEPENDUDUKAN
// ==============================
model DataKependudukan {
  id          String   @id @default(uuid())
  nik         String   @unique
  namaLengkap String
  tempatLahir String
  tanggalLahir DateTime
  jenisKelamin String
  alamat      String
  rt          String
  rw          String
  dusun       String
  agama       String
  statusKawin String
  pekerjaan   String
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  surat       Surat[]
}

// ==============================
// 5. PERSURATAN (Document Management)
// ==============================
enum StatusSurat {
  TERTUNDA
  TERVERIFIKASI
  DISETUJUI
  DITOLAK
}

model Surat {
  id              String      @id @default(uuid())
  nomorSurat      String?     @unique
  jenisSurat      String      // e.g., "SKU", "SKTM", "Domisili"
  status          StatusSurat @default(TERTUNDA)
  keperluan       String?
  
  wargaId         String
  warga           DataKependudukan @relation(fields: [wargaId], references: [id])
  
  adminId         String      // Admin yang menginput
  admin           User        @relation("Pencatat", fields: [adminId], references: [id])
  
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id])

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// ==============================
// 6. BERITA & ARTIKEL (CMS)
// ==============================
model Berita {
  id          String   @id @default(uuid())
  judul       String
  slug        String   @unique
  konten      String   @db.Text
  gambar      String?  // URL gambar
  kategori    String   @default("Umum")
  views       Int      @default(0)
  isPublished Boolean  @default(false)
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VillageProfile {
  id          String   @id @default(uuid())
  tenantId    String   @unique
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  visi        String?  @db.Text
  misi        Json?    // Array of strings
  sejarah     String?  @db.Text
  luasWilayah String?
  batasUtara  String?
  batasSelatan String?
  batasTimur  String?
  batasBarat  String?
  gallery     Json?    // Array of URLs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BumdesFinancial {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  title       String
  amount      Float
  type        String   // INCOME, EXPENSE
  date        DateTime @default(now())
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lembaga {
  id          String   @id @default(uuid())
  name        String   // e.g., "LPM", "PKK"
  fullName    String
  description String?  @db.Text
  memberCount Int      @default(0)
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

